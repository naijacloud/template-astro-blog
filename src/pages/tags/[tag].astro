---
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts } from '../../posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---
<Base title={`Posts tagged ${tag}`}>
  <section class="hero small"><p class="eyebrow">Tag</p><h1>{tag}</h1></section>
  <ul class="posts">
    {posts.map((post) => (
      <li><a href={`/posts/${post.id}.html`}><span class="date">{formatDate(post.data.date)}</span><span class="title">{post.data.title}</span><span class="desc">{post.data.description}</span></a></li>
    ))}
  </ul>
</Base>
