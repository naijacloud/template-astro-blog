---
import Base from '../layouts/Base.astro';
import { SITE_DESCRIPTION } from '../consts';
import { formatDate, getPosts } from '../posts';

const posts = await getPosts();
---
<Base>
  <section class="hero">
    <p class="eyebrow">Blog</p>
    <h1>{SITE_DESCRIPTION}</h1>
  </section>
  <ul class="posts">
    {posts.map((post) => (
      <li>
        <a href={`/posts/${post.id}.html`}>
          <span class="date">{formatDate(post.data.date)}</span>
          <span class="title">{post.data.title}</span>
          <span class="desc">{post.data.description}</span>
          <span class="tags">{post.data.tags.map((t) => <span class="tag">{t}</span>)}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
