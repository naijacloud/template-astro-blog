---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts } from '../../posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article class="post">
    <p class="date">{formatDate(post.data.date)}</p>
    <h1>{post.data.title}</h1>
    <p class="tags">{post.data.tags.map((t) => <a class="tag" href={`/tags/${t}/`}>{t}</a>)}</p>
    <div class="prose"><Content /></div>
  </article>
</Base>
